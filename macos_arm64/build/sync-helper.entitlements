<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  rbdb-sync-helper — единственный бинарь с послаблением library validation.

	  До build 270 он был PyInstaller onefile: на старте распаковывал питоновские .so во
	  временную папку и грузил их через dlopen, а подписаны они были не нашим Team ID —
	  library validation (она включается вместе с hardened runtime) убила бы процесс при
	  первом же импорте.

	  С build 270 это onedir в Contents/Resources/rbdb-sync-helper/, и каждый .so/.dylib
	  подписан нашим Developer ID (rbdb_sync_helper/sign_helper_dir.sh) — library validation
	  их уже пропустила бы. Послабление оставлено как страховка: если PyInstaller однажды
	  принесёт файл, который sign_helper_dir.sh не распознает как Mach-O, Sync не умрёт
	  у всех разом. Снять — отдельной задачей, с дымовым прогоном подписанного хелпера на CI.

	  Hardened runtime при этом обязателен: без него Apple не нотаризует бандл вообще.
	  Остальные бинари бандла (RimeoAgent, rbdb-helper) подписаны без послаблений.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
